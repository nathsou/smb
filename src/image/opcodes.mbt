// The 151 documented NMOS 6502 encodings. Illegal opcodes fail closed.
pub fn encoding(op: @parse.OpCode, mode: String) -> Int? {
  match (op, mode) {
    (BRK, "imp") => Some(0x00)
    (ORA, "indx") => Some(0x01)
    (ORA, "zp") => Some(0x05)
    (ASL, "zp") => Some(0x06)
    (PHP, "imp") => Some(0x08)
    (ORA, "imm") => Some(0x09)
    (ASL, "acc") => Some(0x0a)
    (ORA, "abs") => Some(0x0d)
    (ASL, "abs") => Some(0x0e)
    (BPL, "rel") => Some(0x10)
    (ORA, "indy") => Some(0x11)
    (ORA, "zpx") => Some(0x15)
    (ASL, "zpx") => Some(0x16)
    (CLC, "imp") => Some(0x18)
    (ORA, "absy") => Some(0x19)
    (ORA, "absx") => Some(0x1d)
    (ASL, "absx") => Some(0x1e)
    (JSR, "abs") => Some(0x20)
    (AND, "indx") => Some(0x21)
    (BIT, "zp") => Some(0x24)
    (AND, "zp") => Some(0x25)
    (ROL, "zp") => Some(0x26)
    (PLP, "imp") => Some(0x28)
    (AND, "imm") => Some(0x29)
    (ROL, "acc") => Some(0x2a)
    (BIT, "abs") => Some(0x2c)
    (AND, "abs") => Some(0x2d)
    (ROL, "abs") => Some(0x2e)
    (BMI, "rel") => Some(0x30)
    (AND, "indy") => Some(0x31)
    (AND, "zpx") => Some(0x35)
    (ROL, "zpx") => Some(0x36)
    (SEC, "imp") => Some(0x38)
    (AND, "absy") => Some(0x39)
    (AND, "absx") => Some(0x3d)
    (ROL, "absx") => Some(0x3e)
    (RTI, "imp") => Some(0x40)
    (EOR, "indx") => Some(0x41)
    (EOR, "zp") => Some(0x45)
    (LSR, "zp") => Some(0x46)
    (PHA, "imp") => Some(0x48)
    (EOR, "imm") => Some(0x49)
    (LSR, "acc") => Some(0x4a)
    (JMP, "abs") => Some(0x4c)
    (EOR, "abs") => Some(0x4d)
    (LSR, "abs") => Some(0x4e)
    (BVC, "rel") => Some(0x50)
    (EOR, "indy") => Some(0x51)
    (EOR, "zpx") => Some(0x55)
    (LSR, "zpx") => Some(0x56)
    (CLI, "imp") => Some(0x58)
    (EOR, "absy") => Some(0x59)
    (EOR, "absx") => Some(0x5d)
    (LSR, "absx") => Some(0x5e)
    (RTS, "imp") => Some(0x60)
    (ADC, "indx") => Some(0x61)
    (ADC, "zp") => Some(0x65)
    (ROR, "zp") => Some(0x66)
    (PLA, "imp") => Some(0x68)
    (ADC, "imm") => Some(0x69)
    (ROR, "acc") => Some(0x6a)
    (JMP, "ind") => Some(0x6c)
    (ADC, "abs") => Some(0x6d)
    (ROR, "abs") => Some(0x6e)
    (BVS, "rel") => Some(0x70)
    (ADC, "indy") => Some(0x71)
    (ADC, "zpx") => Some(0x75)
    (ROR, "zpx") => Some(0x76)
    (SEI, "imp") => Some(0x78)
    (ADC, "absy") => Some(0x79)
    (ADC, "absx") => Some(0x7d)
    (ROR, "absx") => Some(0x7e)
    (STA, "indx") => Some(0x81)
    (STY, "zp") => Some(0x84)
    (STA, "zp") => Some(0x85)
    (STX, "zp") => Some(0x86)
    (DEY, "imp") => Some(0x88)
    (TXA, "imp") => Some(0x8a)
    (STY, "abs") => Some(0x8c)
    (STA, "abs") => Some(0x8d)
    (STX, "abs") => Some(0x8e)
    (BCC, "rel") => Some(0x90)
    (STA, "indy") => Some(0x91)
    (STY, "zpx") => Some(0x94)
    (STA, "zpx") => Some(0x95)
    (STX, "zpy") => Some(0x96)
    (TYA, "imp") => Some(0x98)
    (STA, "absy") => Some(0x99)
    (TXS, "imp") => Some(0x9a)
    (STA, "absx") => Some(0x9d)
    (LDY, "imm") => Some(0xa0)
    (LDA, "indx") => Some(0xa1)
    (LDX, "imm") => Some(0xa2)
    (LDY, "zp") => Some(0xa4)
    (LDA, "zp") => Some(0xa5)
    (LDX, "zp") => Some(0xa6)
    (TAY, "imp") => Some(0xa8)
    (LDA, "imm") => Some(0xa9)
    (TAX, "imp") => Some(0xaa)
    (LDY, "abs") => Some(0xac)
    (LDA, "abs") => Some(0xad)
    (LDX, "abs") => Some(0xae)
    (BCS, "rel") => Some(0xb0)
    (LDA, "indy") => Some(0xb1)
    (LDY, "zpx") => Some(0xb4)
    (LDA, "zpx") => Some(0xb5)
    (LDX, "zpy") => Some(0xb6)
    (CLV, "imp") => Some(0xb8)
    (LDA, "absy") => Some(0xb9)
    (TSX, "imp") => Some(0xba)
    (LDY, "absx") => Some(0xbc)
    (LDA, "absx") => Some(0xbd)
    (LDX, "absy") => Some(0xbe)
    (CPY, "imm") => Some(0xc0)
    (CMP, "indx") => Some(0xc1)
    (CPY, "zp") => Some(0xc4)
    (CMP, "zp") => Some(0xc5)
    (DEC, "zp") => Some(0xc6)
    (INY, "imp") => Some(0xc8)
    (CMP, "imm") => Some(0xc9)
    (DEX, "imp") => Some(0xca)
    (CPY, "abs") => Some(0xcc)
    (CMP, "abs") => Some(0xcd)
    (DEC, "abs") => Some(0xce)
    (BNE, "rel") => Some(0xd0)
    (CMP, "indy") => Some(0xd1)
    (CMP, "zpx") => Some(0xd5)
    (DEC, "zpx") => Some(0xd6)
    (CLD, "imp") => Some(0xd8)
    (CMP, "absy") => Some(0xd9)
    (CMP, "absx") => Some(0xdd)
    (DEC, "absx") => Some(0xde)
    (CPX, "imm") => Some(0xe0)
    (SBC, "indx") => Some(0xe1)
    (CPX, "zp") => Some(0xe4)
    (SBC, "zp") => Some(0xe5)
    (INC, "zp") => Some(0xe6)
    (INX, "imp") => Some(0xe8)
    (SBC, "imm") => Some(0xe9)
    (NOP, "imp") => Some(0xea)
    (CPX, "abs") => Some(0xec)
    (SBC, "abs") => Some(0xed)
    (INC, "abs") => Some(0xee)
    (BEQ, "rel") => Some(0xf0)
    (SBC, "indy") => Some(0xf1)
    (SBC, "zpx") => Some(0xf5)
    (INC, "zpx") => Some(0xf6)
    (SED, "imp") => Some(0xf8)
    (SBC, "absy") => Some(0xf9)
    (SBC, "absx") => Some(0xfd)
    (INC, "absx") => Some(0xfe)
    _ => None
  }
}

pub fn decoding(byte: Int) -> (@parse.OpCode, String)? {
  match byte {
    0x00 => Some((BRK, "imp"))
    0x01 => Some((ORA, "indx"))
    0x05 => Some((ORA, "zp"))
    0x06 => Some((ASL, "zp"))
    0x08 => Some((PHP, "imp"))
    0x09 => Some((ORA, "imm"))
    0x0a => Some((ASL, "acc"))
    0x0d => Some((ORA, "abs"))
    0x0e => Some((ASL, "abs"))
    0x10 => Some((BPL, "rel"))
    0x11 => Some((ORA, "indy"))
    0x15 => Some((ORA, "zpx"))
    0x16 => Some((ASL, "zpx"))
    0x18 => Some((CLC, "imp"))
    0x19 => Some((ORA, "absy"))
    0x1d => Some((ORA, "absx"))
    0x1e => Some((ASL, "absx"))
    0x20 => Some((JSR, "abs"))
    0x21 => Some((AND, "indx"))
    0x24 => Some((BIT, "zp"))
    0x25 => Some((AND, "zp"))
    0x26 => Some((ROL, "zp"))
    0x28 => Some((PLP, "imp"))
    0x29 => Some((AND, "imm"))
    0x2a => Some((ROL, "acc"))
    0x2c => Some((BIT, "abs"))
    0x2d => Some((AND, "abs"))
    0x2e => Some((ROL, "abs"))
    0x30 => Some((BMI, "rel"))
    0x31 => Some((AND, "indy"))
    0x35 => Some((AND, "zpx"))
    0x36 => Some((ROL, "zpx"))
    0x38 => Some((SEC, "imp"))
    0x39 => Some((AND, "absy"))
    0x3d => Some((AND, "absx"))
    0x3e => Some((ROL, "absx"))
    0x40 => Some((RTI, "imp"))
    0x41 => Some((EOR, "indx"))
    0x45 => Some((EOR, "zp"))
    0x46 => Some((LSR, "zp"))
    0x48 => Some((PHA, "imp"))
    0x49 => Some((EOR, "imm"))
    0x4a => Some((LSR, "acc"))
    0x4c => Some((JMP, "abs"))
    0x4d => Some((EOR, "abs"))
    0x4e => Some((LSR, "abs"))
    0x50 => Some((BVC, "rel"))
    0x51 => Some((EOR, "indy"))
    0x55 => Some((EOR, "zpx"))
    0x56 => Some((LSR, "zpx"))
    0x58 => Some((CLI, "imp"))
