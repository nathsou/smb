    0x5d => Some((EOR, "absx"))
    0x5e => Some((LSR, "absx"))
    0x60 => Some((RTS, "imp"))
    0x61 => Some((ADC, "indx"))
    0x65 => Some((ADC, "zp"))
    0x66 => Some((ROR, "zp"))
    0x68 => Some((PLA, "imp"))
    0x69 => Some((ADC, "imm"))
    0x6a => Some((ROR, "acc"))
    0x6c => Some((JMP, "ind"))
    0x6d => Some((ADC, "abs"))
    0x6e => Some((ROR, "abs"))
    0x70 => Some((BVS, "rel"))
    0x71 => Some((ADC, "indy"))
    0x75 => Some((ADC, "zpx"))
    0x76 => Some((ROR, "zpx"))
    0x78 => Some((SEI, "imp"))
    0x79 => Some((ADC, "absy"))
    0x7d => Some((ADC, "absx"))
    0x7e => Some((ROR, "absx"))
    0x81 => Some((STA, "indx"))
    0x84 => Some((STY, "zp"))
    0x85 => Some((STA, "zp"))
    0x86 => Some((STX, "zp"))
    0x88 => Some((DEY, "imp"))
    0x8a => Some((TXA, "imp"))
    0x8c => Some((STY, "abs"))
    0x8d => Some((STA, "abs"))
    0x8e => Some((STX, "abs"))
    0x90 => Some((BCC, "rel"))
    0x91 => Some((STA, "indy"))
    0x94 => Some((STY, "zpx"))
    0x95 => Some((STA, "zpx"))
    0x96 => Some((STX, "zpy"))
    0x98 => Some((TYA, "imp"))
    0x99 => Some((STA, "absy"))
    0x9a => Some((TXS, "imp"))
    0x9d => Some((STA, "absx"))
    0xa0 => Some((LDY, "imm"))
    0xa1 => Some((LDA, "indx"))
    0xa2 => Some((LDX, "imm"))
    0xa4 => Some((LDY, "zp"))
    0xa5 => Some((LDA, "zp"))
    0xa6 => Some((LDX, "zp"))
    0xa8 => Some((TAY, "imp"))
    0xa9 => Some((LDA, "imm"))
    0xaa => Some((TAX, "imp"))
    0xac => Some((LDY, "abs"))
    0xad => Some((LDA, "abs"))
    0xae => Some((LDX, "abs"))
    0xb0 => Some((BCS, "rel"))
    0xb1 => Some((LDA, "indy"))
    0xb4 => Some((LDY, "zpx"))
    0xb5 => Some((LDA, "zpx"))
    0xb6 => Some((LDX, "zpy"))
    0xb8 => Some((CLV, "imp"))
    0xb9 => Some((LDA, "absy"))
    0xba => Some((TSX, "imp"))
    0xbc => Some((LDY, "absx"))
    0xbd => Some((LDA, "absx"))
    0xbe => Some((LDX, "absy"))
    0xc0 => Some((CPY, "imm"))
    0xc1 => Some((CMP, "indx"))
    0xc4 => Some((CPY, "zp"))
    0xc5 => Some((CMP, "zp"))
    0xc6 => Some((DEC, "zp"))
    0xc8 => Some((INY, "imp"))
    0xc9 => Some((CMP, "imm"))
    0xca => Some((DEX, "imp"))
    0xcc => Some((CPY, "abs"))
    0xcd => Some((CMP, "abs"))
    0xce => Some((DEC, "abs"))
    0xd0 => Some((BNE, "rel"))
    0xd1 => Some((CMP, "indy"))
    0xd5 => Some((CMP, "zpx"))
    0xd6 => Some((DEC, "zpx"))
    0xd8 => Some((CLD, "imp"))
    0xd9 => Some((CMP, "absy"))
    0xdd => Some((CMP, "absx"))
    0xde => Some((DEC, "absx"))
    0xe0 => Some((CPX, "imm"))
    0xe1 => Some((SBC, "indx"))
    0xe4 => Some((CPX, "zp"))
    0xe5 => Some((SBC, "zp"))
    0xe6 => Some((INC, "zp"))
    0xe8 => Some((INX, "imp"))
    0xe9 => Some((SBC, "imm"))
    0xea => Some((NOP, "imp"))
    0xec => Some((CPX, "abs"))
    0xed => Some((SBC, "abs"))
    0xee => Some((INC, "abs"))
    0xf0 => Some((BEQ, "rel"))
    0xf1 => Some((SBC, "indy"))
    0xf5 => Some((SBC, "zpx"))
    0xf6 => Some((INC, "zpx"))
    0xf8 => Some((SED, "imp"))
    0xf9 => Some((SBC, "absy"))
    0xfd => Some((SBC, "absx"))
    0xfe => Some((INC, "absx"))
    _ => None
  }
}
